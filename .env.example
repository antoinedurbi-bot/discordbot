# Token du bot (Developer Portal > Bot > Token) — NE JAMAIS COMMIT le vrai token
DISCORD_TOKEN=

# Client ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur principal à protéger (accélère le déploiement des commandes slash)
GUILD_ID=

# ID(s) des propriétaires/owners du bot, séparés par des virgules
# Ces comptes sont toujours whitelistés et ne peuvent jamais être sanctionnés par l'anti-nuke
OWNER_IDS=

# ID du salon où le bot enverra les alertes de sécurité (créé auto si absent, sinon renseigner)
LOG_CHANNEL_ID=

# Clé API Anthropic (console.anthropic.com) — active le chat IA (*ai / mention du bot)
# Sans cette clé, le bot répond simplement que le chat IA n'est pas configuré.
ANTHROPIC_API_KEY=
